# Environment configuration file
# Copy this to .env and update with your configuration

# Database Configuration
DATABASE_URL=postgresql+psycopg2://example:example@host:port/db_name

# Server Configuration
DEBUG=False
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=

# Set REQUIRE_INGEST_AUTH=true and provide a rotated secret in production.
REQUIRE_INGEST_AUTH=false
INGEST_API_KEY=

# Redis Configuration (for Celery workers)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# SQLAlchemy pool tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
